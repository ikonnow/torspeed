{
 "manifest_version": 3,
 "name": "torspeed",
 "version": "0.6",
 "description": "Live Tor speed + fastest exit (local torspeed daemon)",
 "key": "",
 "action": {"default_popup": "popup.html"},
 "background": {"service_worker": "bg.js"},
 "permissions": ["nativeMessaging", "proxy", "privacy", "alarms", "storage"],
 "host_permissions": ["http://127.0.0.1:8765/*"]
}
